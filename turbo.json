{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {},
    "lint": {},
    "test": {},
    "test:e2e": {
      "cache": false,
      "dependsOn": [
        "build"
      ]
    },
    "check-deps": {}
  }
}
