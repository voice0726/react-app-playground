prefix_rule(pattern=["pnpm", "build"], decision="allow")
prefix_rule(pattern=["pnpm", "lint"], decision="allow")
prefix_rule(pattern=["pnpm", "test"], decision="allow")
prefix_rule(pattern=["pnpm", "typecheck"], decision="allow")
prefix_rule(pattern=["pnpm", "check-deps"], decision="allow")
prefix_rule(pattern=["pnpm", "knip"], decision="allow")
prefix_rule(pattern=["pnpm", "test:e2e"], decision="allow")
prefix_rule(pattern=["pnpm", "test:e2e:backend"], decision="allow")
prefix_rule(pattern=["pnpm", "test:e2e:standalone"], decision="allow")
prefix_rule(pattern=["pnpm", "test:vrt"], decision="allow")
prefix_rule(pattern=["pnpm", "--filter", "@playground/web", "typecheck"], decision="allow")
prefix_rule(pattern=["pnpm", "--filter", "@playground/web", "build"], decision="allow")
prefix_rule(pattern=["pnpm", "--filter", "@playground/web", "lint"], decision="allow")
prefix_rule(pattern=["pnpm", "--filter", "@playground/web", "test"], decision="allow")
prefix_rule(pattern=["pnpm", "--filter", "@playground/web", "check-deps"], decision="allow")
