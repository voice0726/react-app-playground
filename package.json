{
  "name": "react-app-playground",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm test:e2e:backend",
    "test:e2e:backend": "pnpm --filter @playground/web test:e2e:backend",
    "test:e2e:standalone": "pnpm --filter @playground/web test:e2e:standalone",
    "test:vrt": "pnpm --filter @playground/web test:vrt",
    "test:vrt:update": "pnpm --filter @playground/web test:vrt:update",
    "check-deps": "turbo run check-deps",
    "knip": "knip"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "turbo": "2.11.7"
  }
}
