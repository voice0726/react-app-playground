{
  "name": "@playground/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src worker vite.config.ts vitest.worker.config.ts vitest.workerd.config.ts vitest.runtime.config.ts",
    "test": "vitest run && pnpm test:worker",
    "test:worker": "pnpm build && vitest run --config vitest.worker.config.ts && vitest run --config vitest.workerd.config.ts && vitest run --config vitest.runtime.config.ts",
    "dev:worker": "pnpm build && wrangler dev --local",
    "deploy": "pnpm build && wrangler deploy",
    "test:watch": "vitest",
    "test:e2e": "pnpm test:e2e:backend",
    "test:e2e:backend": "playwright test --config=../../tests/backend-integration.config.ts",
    "test:e2e:standalone": "playwright test --config=../../tests/standalone.config.ts",
    "test:vrt": "playwright test --config=../../tests/visual.config.ts",
    "test:vrt:update": "playwright test --config=../../tests/visual.config.ts --update-snapshots=all",
    "check-deps": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@mantine/core": "9.7.3",
    "@mantine/dates": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/modals": "9.7.3",
    "@mantine/notifications": "9.7.3",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-table": "9.2.8",
    "date-fns": "4.4.0",
    "dayjs": "1.11.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.89.0",
    "ts-pattern": "5.9.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@playwright/test": "1.64.1",
    "@tanstack/router-plugin": "1.168.43",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "18.7.0",
    "jsdom": "30.1.2",
    "msw": "3.0.2",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.151.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
