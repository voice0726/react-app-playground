{
  "name": "@playground/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src worker vite.config.ts vitest.worker.config.ts vitest.workerd.config.ts vitest.runtime.config.ts",
    "test": "vitest run && pnpm test:worker",
    "test:worker": "pnpm build && vitest run --config vitest.worker.config.ts && vitest run --config vitest.workerd.config.ts && vitest run --config vitest.runtime.config.ts",
    "dev:worker": "pnpm build && wrangler dev --local",
    "deploy": "pnpm build && wrangler deploy",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=../../tests/backend-integration.config.ts",
    "check-deps": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@mantine/core": "9.5.0",
    "@mantine/dates": "9.5.0",
    "@mantine/hooks": "9.7.1",
    "@mantine/modals": "^9.7.1",
    "@mantine/notifications": "9.5.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-table": "8.21.3",
    "date-fns": "4.4.0",
    "dayjs": "1.11.21",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "ts-pattern": "5.9.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@playwright/test": "1.62.1",
    "@tanstack/router-plugin": "1.168.23",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "dependency-cruiser": "18.1.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "oxlint": "1.76.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wrangler": "4.149.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
